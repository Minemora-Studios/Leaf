From: ininjagod98 <181880040+ininjagod98@users.noreply.github.com>
Date: Fri, 4 Sep 2026 12:00:00 -0500
Subject: [PATCH] Minemora - configurable villager breeding bed search radius

VillagerMakeLove#takeVacantBed searches for a free HOME POI at the hardcoded
AcquirePoi.SCAN_RANGE of 48 blocks. Defaults to vanilla's 48.

diff --git a/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java b/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
index 350cfa051d0a12d596efd041ff36ad89270b75cf..1262e88a1f3700e38508cb3d28d8f7c7dc1b2519 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
@@ -98,7 +98,7 @@ public class VillagerMakeLove extends Behavior<Villager> {
 
     private Optional<BlockPos> takeVacantBed(final ServerLevel level, final Villager body) {
         return level.getPoiManager()
-            .take(p -> p.is(PoiTypes.HOME), (poiType, poiPos) -> this.canReach(body, poiPos, poiType), body.blockPosition(), AcquirePoi.SCAN_RANGE);
+            .take(p -> p.is(PoiTypes.HOME), (poiType, poiPos) -> this.canReach(body, poiPos, poiType), body.blockPosition(), org.dreeam.leaf.config.modules.opt.MinemoraTweaks.villagerBreedingBedSearchRadius); // Minemora - configurable villager breeding bed search radius
     }
 
     private boolean canReach(final Villager body, final BlockPos poiPos, final Holder<PoiType> poiType) {
