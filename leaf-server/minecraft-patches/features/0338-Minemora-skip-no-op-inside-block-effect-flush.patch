From: ininjagod98 <181880040+ininjagod98@users.noreply.github.com>
Date: Fri, 4 Sep 2026 18:00:00 -0500
Subject: [PATCH] Minemora - skip no-op inside block effect flush

StepBasedCollector#flushStep walks all five InsideBlockEffectType slots on every
call, and applyAndClear calls it once per entity per tick whether or not the
entity touched a block with an effect. Profiling a survival server showed 1.34%
of the server tick inside flushStep, almost all of it for entities standing in
air that never recorded anything.

flushStep empties every list and slot it reads, so after any flush the collector
is provably empty. A single boolean recording whether apply/runBefore/runAfter
was called since the last flush therefore makes the skip exactly equivalent
rather than a heuristic.

diff --git a/net/minecraft/world/entity/InsideBlockEffectApplier.java b/net/minecraft/world/entity/InsideBlockEffectApplier.java
index 149e2a11534aaffe00b7304898c4f1eb932651c2..b9a99d1da43093b524283f2c93f3f8ef1514dc44 100644
--- a/net/minecraft/world/entity/InsideBlockEffectApplier.java
+++ b/net/minecraft/world/entity/InsideBlockEffectApplier.java
@@ -38,6 +38,13 @@ public interface InsideBlockEffectApplier {
         private final List<Consumer<Entity>>[] afterEffectsInStep = new List[APPLY_ORDER.length];
         private final it.unimi.dsi.fastutil.objects.ObjectArrayList<Consumer<Entity>> finalEffects = new it.unimi.dsi.fastutil.objects.ObjectArrayList<>();
         private int lastStep = -1;
+        // Minemora start - skip no-op flush
+        // flushStep() empties everything it reads, so after any flush the arrays are
+        // provably empty. This tracks whether anything was recorded since then, which
+        // lets the common case - an entity that touched no effect block at all - skip
+        // the whole APPLY_ORDER walk instead of checking five empty slots every tick.
+        private boolean anyRecorded;
+        // Minemora end - skip no-op flush
 
         public StepBasedCollector() {
             for (int i = 0; i < APPLY_ORDER.length; i++) {
@@ -57,6 +64,12 @@ public interface InsideBlockEffectApplier {
             this.flushStep();
 
             it.unimi.dsi.fastutil.objects.ObjectArrayList<Consumer<Entity>> effects = this.finalEffects;
+            // Minemora start - skip no-op flush
+            if (effects.isEmpty()) {
+                this.lastStep = -1;
+                return;
+            }
+            // Minemora end - skip no-op flush
             Object[] raw = effects.elements();
             for (int i = 0, size = effects.size(); i < size; i++) {
                 if (!entity.isAlive()) {
@@ -71,6 +84,8 @@ public interface InsideBlockEffectApplier {
         }
 
         private void flushStep() {
+            if (!this.anyRecorded) return; // Minemora - skip no-op flush
+            this.anyRecorded = false; // Minemora - skip no-op flush
             final int len = APPLY_ORDER.length;
             final List<Consumer<Entity>>[] beforeArr = this.beforeEffectsInStep;
             final Consumer<Entity>[] effectArr = this.effectsInStep;
@@ -103,16 +118,19 @@ public interface InsideBlockEffectApplier {
 
         @Override
         public void apply(final InsideBlockEffectType type) {
+            this.anyRecorded = true; // Minemora - skip no-op flush
             effectsInStep[type.ordinal()] = recorded(type);
         }
 
         @Override
         public void runBefore(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.anyRecorded = true; // Minemora - skip no-op flush
             beforeEffectsInStep[type.ordinal()].add(effect);
         }
 
         @Override
         public void runAfter(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.anyRecorded = true; // Minemora - skip no-op flush
             afterEffectsInStep[type.ordinal()].add(effect);
         }
         // Leaf end - optimize checkInsideBlocks calls
